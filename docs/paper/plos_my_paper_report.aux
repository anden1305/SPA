\newlabel{table1}{{1}{5}{\textbf {Joint holdout prior NMI by fold (best-of-three seeds, locked recipes, $K{=}3$).}}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Fair per-laboratory holdout comparison (mean over four folds; $K{=}3$).} \textbf  {Joint:} train on all laboratories; report metrics on held-out mice from the listed site only. \textbf  {Within:} train and evaluate within the same site. All rows use the \textbf  {same locked preprocessing} per laboratory (spectral bandpass, montage, post-normalisation from incohort ablation winners; \nameref {S4_Appendix}) and matched CNN--VAE capacity ($d{=}6$, \texttt  {wide\_mlp}, 200 epochs, batch 128, three seeds). cGMVAE, HMMGMVAE, and cHMM--GMVAE share learning rate $1.3 \times 10^{-3}$; they differ only in embedding use ($8$ vs.\ $0$), sequence length ($T{=}1$ vs.\ $T{=}64$), and prior type (static GMM vs.\ HMM--GMM vs.\ warm sticky HMM--GMM). HMM (raw) uses the time-domain pipeline (no shared deep front-end). VAE models report \textbf  {best-of-three} prior NMI and matching macro accuracy, averaged across folds. Per-fold within-lab and joint breakdowns: \nameref {S2_Table}. Incohort ceiling NMI from per-lab ablation sweeps (upper reference, not holdout): \nameref {S7_Table}. HMM (raw): $\mathit  {runs}{=}1$; incomplete grid (\nameref {S6_Table}).}}{6}{table.caption.13}\protected@file@percent }
\newlabel{table2}{{2}{6}{\textbf {Fair per-laboratory holdout comparison (mean over four folds; $K{=}3$).} \textbf {Joint:} train on all laboratories; report metrics on held-out mice from the listed site only. \textbf {Within:} train and evaluate within the same site. All rows use the \textbf {same locked preprocessing} per laboratory (spectral bandpass, montage, post-normalisation from incohort ablation winners; \nameref {S4_Appendix}) and matched CNN--VAE capacity ($d{=}6$, \texttt {wide\_mlp}, 200 epochs, batch 128, three seeds). cGMVAE, HMMGMVAE, and cHMM--GMVAE share learning rate $1.3 \times 10^{-3}$; they differ only in embedding use ($8$ vs.\ $0$), sequence length ($T{=}1$ vs.\ $T{=}64$), and prior type (static GMM vs.\ HMM--GMM vs.\ warm sticky HMM--GMM). HMM (raw) uses the time-domain pipeline (no shared deep front-end). VAE models report \textbf {best-of-three} prior NMI and matching macro accuracy, averaged across folds. Per-fold within-lab and joint breakdowns: \nameref {S2_Table}. Incohort ceiling NMI from per-lab ablation sweeps (upper reference, not holdout): \nameref {S7_Table}. HMM (raw): $\mathit {runs}{=}1$; incomplete grid (\nameref {S6_Table})}{table.caption.13}{}}
\citation{somnotate2024,grieger2021prerem}
