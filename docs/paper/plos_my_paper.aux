\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Study overview and zero-shot holdout protocol.} \textbf  {A,} MSSV multi-laboratory cohort with four-fold cross-validation; mice from three folds train a population model evaluated on the held-out fourth fold. \textbf  {B,} Training uses decoder-only subject conditioning for reconstruction; holdout staging encodes EEG/EMG without subject identifiers and assigns states from the HMM--GMM prior only. \textbf  {C,} Model ladder from feature HMM through HMMGMVAE, cGMVAE, and cHMM--GMVAE.}}{3}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig1}{{1}{3}{\textbf {Study overview and zero-shot holdout protocol.} \textbf {A,} MSSV multi-laboratory cohort with four-fold cross-validation; mice from three folds train a population model evaluated on the held-out fourth fold. \textbf {B,} Training uses decoder-only subject conditioning for reconstruction; holdout staging encodes EEG/EMG without subject identifiers and assigns states from the HMM--GMM prior only. \textbf {C,} Model ladder from feature HMM through HMMGMVAE, cGMVAE, and cHMM--GMVAE}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Joint cross-lab holdout prior NMI.} \textbf  {A,} Mean best-of-three prior NMI across four folds for cGMVAE and cHMM--GMVAE; error bars span fold min--max; dashed line marks thesis feature HMM baseline (0.51). \textbf  {B,} Per-fold grouped bars (labs 2, 3, and 5 pooled).}}{3}{figure.caption.7}\protected@file@percent }
